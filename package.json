{
  "name": "portwhim",
  "version": "0.1.2",
  "description": "Local ports and processes, powered by Tauri.",
  "private": true,
  "author": "Portwhim contributors",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:live": "cargo test --manifest-path src-tauri/Cargo.toml --test live real_scan_and_stop -- --ignored --nocapture",
    "pack": "tauri build --no-bundle",
    "dist": "tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.577.0",
    "motion": "13.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
