{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portwhim",
  "version": "0.1.1",
  "identifier": "dev.portwhim.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Portwhim","width":1440,"height":940,"minWidth":1000,"minHeight":680}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":true,"targets":"all","icon":["../public/brand/icon.icns","../public/brand/icon.png","../public/brand/icon.ico"],"windows":{"webviewInstallMode":{"type":"downloadBootstrapper"}}}
}
